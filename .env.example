# ==============================================================================
# SHROTIHOST ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env.local` to override default mock providers with live credentials.
# In development / sandbox mode, all services gracefully fall back to typed mock providers
# when credentials are absent or prefixed with 'mock_'.
# ==============================================================================

# Application Base
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME="Shroti Telecom Pvt. Ltd."
NEXT_PUBLIC_BRAND_NAME="ShrotiHost"
NEXT_PUBLIC_SUPPORT_EMAIL=support@shrotihost.in
NEXT_PUBLIC_SUPPORT_PHONE="+91 82794 87798"

# ------------------------------------------------------------------------------
# 1. PAYMENT GATEWAY: RAZORPAY (India Standard)
# ------------------------------------------------------------------------------
# Obtain from: https://dashboard.razorpay.com/app/keys (Test or Live Mode)
# Leave as 'mock' to use the zero-credential cryptographic simulator.
RAZORPAY_KEY_ID=mock_rzp_key_test_123456
RAZORPAY_KEY_SECRET=mock_rzp_secret_shrotihost_test_987654
RAZORPAY_WEBHOOK_SECRET=mock_rzp_webhook_secret_secure_key_112233

# ------------------------------------------------------------------------------
# 2. CLIENT MANAGEMENT & PROVISIONING: WHMCS
# ------------------------------------------------------------------------------
# Obtain from: WHMCS Admin -> Setup -> General Settings -> API Credentials / Roles
# Live endpoint format: https://portal.shrotihost.in/includes/api.php
WHMCS_API_URL=https://portal.shrotihost.in/includes/api.php
WHMCS_API_IDENTIFIER=mock_whmcs_api_identifier
WHMCS_API_SECRET=mock_whmcs_api_secret_hash
# Product ID mappings (WHMCS PID -> ShrotiHost plan ID)
WHMCS_PID_SHARED_LAUNCH=1
WHMCS_PID_SHARED_GROW=2
WHMCS_PID_SHARED_SCALE=3
WHMCS_PID_SHARED_ENTERPRISE=4

# ------------------------------------------------------------------------------
# 3. DOMAIN REGISTRAR INTEGRATION (ResellerClub / LogicBoxes / Direct EPP)
# ------------------------------------------------------------------------------
# Provider: 'mock' | 'resellerclub' | 'logicboxes'
REGISTRAR_PROVIDER=mock
REGISTRAR_API_URL=https://httpapi.com/api/domains
REGISTRAR_RESELLER_ID=mock_reseller_9901
REGISTRAR_API_KEY=mock_registrar_api_key_3344

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL (Resend / Postmark / SMTP)
# ------------------------------------------------------------------------------
# Provider: 'mock' | 'resend' | 'postmark' | 'smtp'
EMAIL_PROVIDER=mock
RESEND_API_KEY=mock_re_123456789abcdef
EMAIL_FROM="ShrotiHost Cloud <support@shrotihost.in>"
EMAIL_SALES="sales@shrotihost.in"
EMAIL_BILLING="billing@shrotihost.in"

# ------------------------------------------------------------------------------
# 5. DISTRIBUTED IDEMPOTENCY CACHE (Redis / Upstash)
# ------------------------------------------------------------------------------
# Required for multi-instance or serverless container deployments to prevent
# duplicate webhook execution and double-provisioning across server instances.
# Leave empty for single-instance in-memory cache.
REDIS_URL=

# ------------------------------------------------------------------------------
# 6. AI HOSTING ADVISOR (Google Gemini)
# ------------------------------------------------------------------------------
# Obtain from: https://aistudio.google.com/app/apikey
# If unset, the server automatically uses the high-precision deterministic rules engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
